[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/name_prompt.gd" id="1_prompt"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_window"]
content_margin_left = 48.0
content_margin_top = 40.0
content_margin_right = 48.0
content_margin_bottom = 40.0
bg_color = Color(0.105882, 0.12549, 0.180392, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.309804, 0.764706, 0.968627, 1)
corner_radius_top_left = 18
corner_radius_top_right = 18
corner_radius_bottom_right = 18
corner_radius_bottom_left = 18

[node name="NamePrompt" type="PanelContainer"]
custom_minimum_size = Vector2(780, 0)
theme_override_styles/panel = SubResource("StyleBoxFlat_window")
script = ExtResource("1_prompt")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 24

[node name="TitleLabel" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "¿Cómo te llamas?"
horizontal_alignment = 1

[node name="NameEdit" type="LineEdit" parent="Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 84)
layout_mode = 2
theme_override_font_sizes/font_size = 40
placeholder_text = "Alex"
alignment = 1
max_length = 16
clear_button_enabled = true

[node name="HintLabel" type="Label" parent="Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.65, 0.72, 1)
theme_override_font_sizes/font_size = 22
text = "Máximo 16 caracteres: letras, números, espacio, punto, guion y guion bajo."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="BackButton" type="Button" parent="Content/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 72)
layout_mode = 2
text = "Atrás"

[node name="Spacer" type="Control" parent="Content/Buttons"]
layout_mode = 2
size_flags_horizontal = 3

[node name="ConfirmButton" type="Button" parent="Content/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 72)
layout_mode = 2
text = "Siguiente"
