[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/dashboard/game_over.gd" id="1_game_over"]
[ext_resource type="PackedScene" path="res://scenes/dashboard/report_summary.tscn" id="2_summary"]
[ext_resource type="Script" path="res://scripts/dashboard/report_window.gd" id="3_window"]
[ext_resource type="Script" path="res://scripts/ui/touch_scroll_container.gd" id="4_scroll"]

[node name="GameOver" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_game_over")

[node name="Dimmer" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0431373, 0.0666667, 0.109804, 0.9)
metadata/ui_tokens = {"color": "scrim"}

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Window" type="PanelContainer" parent="Center" node_paths=PackedStringArray("body")]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("3_window")
body = NodePath("Content/Body")

[node name="Content" type="VBoxContainer" parent="Center/Window"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Center/Window/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.301961, 0.368627, 1)
theme_override_font_sizes/font_size = 48
text = "NexusSoft quebró"
horizontal_alignment = 1
metadata/ui_tokens = {"font_color": "danger"}

[node name="Body" type="ScrollContainer" parent="Center/Window/Content"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("4_scroll")

[node name="BodyContent" type="VBoxContainer" parent="Center/Window/Content/Body"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="ReasonLabel" type="Label" parent="Center/Window/Content/Body/BodyContent"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.541176, 0.607843, 0.709804, 1)
theme_override_font_sizes/font_size = 22
text = "El SLA llegó a 0 %."
horizontal_alignment = 1
autowrap_mode = 3
metadata/ui_tokens = {"font_color": "text_muted"}

[node name="Summary" parent="Center/Window/Content/Body/BodyContent" instance=ExtResource("2_summary")]
unique_name_in_owner = true
layout_mode = 2

[node name="Buttons" type="HBoxContainer" parent="Center/Window/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 16

[node name="MenuButton" type="Button" parent="Center/Window/Content/Buttons"]
