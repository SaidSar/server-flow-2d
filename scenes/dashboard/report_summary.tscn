[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/dashboard/report_summary.gd" id="1_summary"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_cause"]
content_margin_left = 16.0
content_margin_top = 12.0
content_margin_right = 16.0
content_margin_bottom = 12.0
bg_color = Color(0.0431373, 0.0666667, 0.109804, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10
metadata/ui_tokens = {"bg_color": "well"}

[node name="ReportSummary" type="BoxContainer"]
theme_override_constants/separation = 12
vertical = true
script = ExtResource("1_summary")

[node name="StatsGrid" type="GridContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.8
theme_override_constants/h_separation = 32
theme_override_constants/v_separation = 4
columns = 2

[node name="CauseBox" type="PanelContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("StyleBoxFlat_cause")

[node name="Content" type="VBoxContainer" parent="CauseBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="CauseTitle" type="Label" parent="CauseBox/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.301961, 0.368627, 1)
theme_override_font_sizes/font_size = 24
text = "Causa principal: Red"
metadata/ui_tokens = {"font_color": "danger"}

[node name="CauseText" type="Label" parent="CauseBox/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.901961, 0.929412, 0.968627, 1)
theme_override_font_sizes/font_size = 21
text = "El ancho de banda se saturó: los paquetes hicieron fila."
autowrap_mode = 3
metadata/ui_tokens = {"font_color": "text"}
