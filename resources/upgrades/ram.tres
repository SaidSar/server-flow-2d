[gd_resource type="Resource" script_class="UpgradeData" format=3]

[ext_resource type="Script" path="res://scripts/resources/upgrade_data.gd" id="1_upgrade"]

[resource]
script = ExtResource("1_upgrade")
id = &"ram"
display_name = "RAM"
short_effect = "+50 % concurrencia"
description = "Más memoria para atender más peticiones simultáneas."
concept = "Concurrencia: la RAM limita cuántas peticiones se atienden al mismo tiempo."
target = &"ram_slots"
effect_mode = 1
effect_per_level = 0.5
max_level = 10
base_cost = 30
cost_growth = 1.6
unlock_stage = 1
fixes = Array[StringName]([&"ram"])
